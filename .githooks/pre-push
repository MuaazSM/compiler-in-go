#!/bin/sh
# Blocks a push if any outgoing commit isn't authored and committed by MuaazSM,
# or if its message carries a co-author line.
allowed="170370120+MuaazSM@users.noreply.github.com"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch sends nothing, so there's nothing to check.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New branch: check every commit the remote doesn't already have.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  for sha in $(git rev-list $range); do
    author=$(git log -1 --format='%ae' "$sha")
    committer=$(git log -1 --format='%ce' "$sha")
    if [ "$author" != "$allowed" ] || [ "$committer" != "$allowed" ]; then
      echo "pre-push: $sha has author <$author> / committer <$committer>; expected <$allowed>." >&2
      exit 1
    fi
    if git log -1 --format='%B' "$sha" | grep -qi '^co-authored-by:'; then
      echo "pre-push: $sha has a Co-Authored-By line." >&2
      exit 1
    fi
  done
done
exit 0
